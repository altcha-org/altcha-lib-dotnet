@page
@model Altcha.Example.Sentinel.Pages.IndexModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>ALTCHA Sentinel ASP.NET Core example</title>
    <script type="module" src="https://cdn.jsdelivr.net/npm/altcha@3/dist/main/altcha.min.js"></script>
</head>
<body>
    <h1>ALTCHA Sentinel ASP.NET Core example</h1>
    <form method="post">
        <p>
            <label for="email">Email</label>
            <input id="email" name="email" type="email" />
        </p>
        <p>
            <label for="message">Message</label>
            <textarea id="message" name="message"></textarea>
        </p>
        @* The tag helper sets challenge="{Altcha:Sentinel:ChallengeUrl}" and name="altcha". *@
        <altcha-widget></altcha-widget>
        <button type="submit">Submit</button>
    </form>
    @if (Model.Status is not null)
    {
        <p id="status">@Model.Status</p>
    }
    @if (Model.VerificationData is { } data)
    {
        <dl id="verification-data">
            <dt>Classification</dt>
            <dd>@data.Classification</dd>
            <dt>Score</dt>
            <dd>@data.Score</dd>
            <dt>Country</dt>
            <dd>@data.Location?.CountryCode</dd>
            <dt>Time zone</dt>
            <dd>@data.Location?.TimeZone</dd>
            <dt>Device</dt>
            <dd>@data.Device?.Browser (@data.Device?.Type)</dd>
            <dt>Reasons</dt>
            <dd>@string.Join(", ", data.Reasons ?? [])</dd>
        </dl>
    }
</body>
</html>
